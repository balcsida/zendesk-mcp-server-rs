# Your Zendesk subdomain. For https://acme.zendesk.com this is "acme".
ZENDESK_SUBDOMAIN=xxx

# --- OAuth (recommended) ---------------------------------------------------
# With only ZENDESK_SUBDOMAIN set, run `zendesk-mcp-server auth` (or `zendesk auth`)
# once to authorize. It signs in through the public OAuth client of zcli, Zendesk's
# own CLI, so no OAuth client has to be registered.

# Optional. Identifier of your own *public* OAuth client from Admin Center
# (Apps and integrations > APIs > OAuth clients), used instead of zcli's. There is
# no client secret: this server runs on the operator's own machine and uses PKCE.
# ZENDESK_CLIENT_ID=

# Optional. Defaults to `read write` with zcli's client, else to the scopes that
# cover the documented tool families (see "Choosing scopes" in the README).
# ZENDESK_OAUTH_SCOPES=read

# Optional. Defaults to http://localhost:19186/ with zcli's client (19187 and 19188
# also work), else http://localhost:4567/callback. Must exactly match a redirect URL
# registered on the OAuth client.
# ZENDESK_OAUTH_REDIRECT_URI=http://localhost:4567/callback

# Optional. Defaults to $XDG_CONFIG_HOME/zendesk-mcp/tokens.json
# (~/.config/zendesk-mcp/tokens.json). Keep it out of version control.
# ZENDESK_TOKEN_FILE=

# --- Mobile app OAuth (CLI, no OAuth client needed) -------------------------
# `zendesk mobile-auth` signs in through the Zendesk mobile app's OAuth flow and
# saves the token. The MCP server does not read that file. Pass the token on:
#   ZENDESK_OAUTH_TOKEN=$(zendesk token --mobile) zendesk-mcp-server
# CLI only. Optional. Defaults to ~/.config/zendesk-mcp/mobile_token.json
# ZENDESK_MOBILE_TOKEN_FILE=
# Or set a token manually:
# ZENDESK_OAUTH_TOKEN=xxx

# --- Session cookie --------------------------------------------------------
# The _zendesk_session cookie of a browser signed in to Zendesk.
# ZENDESK_SESSION_COOKIE=xxx

# --- API token (deprecated) ------------------------------------------------
# Zendesk stops accepting API tokens on 2027-04-30 and blocks creating new ones
# from 2026-10-27. An API token also grants this server everything its user can
# do, regardless of who is using the server. Leave these unset when using OAuth.
# ZENDESK_EMAIL=xxx
# ZENDESK_API_KEY=xxx

# --- HTTP transport (optional) ---------------------------------------------
# `zendesk-mcp-server http` serves streamable HTTP at /mcp. A bearer token is
# required. The listen address defaults to 127.0.0.1:8080 (0.0.0.0:8080 in the
# Docker image).
# MCP_HTTP_ADDR=0.0.0.0:8080
# MCP_BEARER_TOKEN=generate-a-long-random-string
# Or, instead of MCP_BEARER_TOKEN, have every client send its own Zendesk token
# as the bearer token and act as that user. Needs only ZENDESK_SUBDOMAIN.
# MCP_PER_USER_AUTH=true

# --- Logging ---------------------------------------------------------------
# Logs go to stderr. Default is info for the server and warn for the CLI.
# RUST_LOG=info
