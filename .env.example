# Your Zendesk subdomain. For https://acme.zendesk.com this is "acme".
ZENDESK_SUBDOMAIN=xxx

# --- OAuth (recommended) ---------------------------------------------------
# Identifier of a *public* OAuth client from Admin Center
# (Apps and integrations > APIs > OAuth clients). There is no client secret:
# this server runs on the operator's own machine and uses PKCE instead.
# After setting this, run `zendesk-mcp-server auth` once to authorize.
ZENDESK_CLIENT_ID=

# Optional. Defaults to the scopes that cover the documented tool families (see
# "Choosing scopes" in the README for the few operations that may need `write`).
# ZENDESK_OAUTH_SCOPES=read tickets:write ticket_attachments:write users:write organizations:write hc:write

# Optional. Must exactly match a redirect URL registered on the OAuth client.
# ZENDESK_OAUTH_REDIRECT_URI=http://localhost:4567/callback

# Optional. Defaults to $XDG_CONFIG_HOME/zendesk-mcp/tokens.json
# (~/.config/zendesk-mcp/tokens.json). Keep it out of version control.
# ZENDESK_TOKEN_FILE=

# --- Mobile app OAuth (no OAuth client needed) -----------------------------
# Run `zendesk-mcp-server mobile-auth` to sign in through the Zendesk mobile
# app's OAuth flow. The token is saved to the mobile token file automatically.
# Optional. Defaults to ~/.config/zendesk-mcp/mobile_token.json
# ZENDESK_MOBILE_TOKEN_FILE=
# Or set a token manually:
# ZENDESK_OAUTH_TOKEN=xxx

# --- Session cookie --------------------------------------------------------
# The _zendesk_session cookie of a browser signed in to Zendesk.
# ZENDESK_SESSION_COOKIE=xxx

# --- API token (deprecated) ------------------------------------------------
# Zendesk stops accepting API tokens on 2027-04-30 and blocks creating new ones
# from 2026-10-27. An API token also grants this server everything its user can
# do, regardless of who is using the server. Leave these unset when using OAuth.
# ZENDESK_EMAIL=xxx
# ZENDESK_API_KEY=xxx

# --- HTTP transport (optional) ---------------------------------------------
# `zendesk-mcp-server http` serves streamable HTTP at /mcp. A bearer token is
# required. The listen address defaults to 127.0.0.1:8080 (0.0.0.0:8080 in the
# Docker image).
# MCP_HTTP_ADDR=0.0.0.0:8080
# MCP_BEARER_TOKEN=generate-a-long-random-string

# --- Logging ---------------------------------------------------------------
# Logs go to stderr. Default is info.
# RUST_LOG=info
